# Configure these in Vercel Project Settings > Environment Variables.
# Never commit real values or share them in chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# After deployment, use: https://YOUR-DEPLOYED-DOMAIN/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Use a long random server-only secret. The app derives a 256-bit AES key from it.
APP_ENCRYPTION_KEY=
# Supabase project URL and service-role key. Service-role key must remain server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional YouTube Data API v3 key for server-side public video search.
# Keep this key server-side; do not prefix it with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
